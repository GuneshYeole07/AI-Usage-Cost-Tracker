# Copy to .env and adjust. Every value is optional; defaults live in app/config.py.
PROJECT_NAME="LLM Token Auditor"
LOG_LEVEL="INFO"

# Database (SQLite file by default)
DATABASE_URL="sqlite:///./ai_tracker.db"

# Where the dashboard finds the backend
BACKEND_API_URL="http://127.0.0.1:8000"

# Waste-rule thresholds (tokens unless noted)
LONG_CONTEXT_THRESHOLD=100000
FRESH_SESSION_BASELINE=20000
LOOP_MIN_CONSECUTIVE_ERRORS=4
REREAD_ALLOWED=2
TOOL_OVERHEAD_THRESHOLD=65000
LEAN_STARTUP_CONTEXT=50000
CACHE_MIN_HIT_RATIO=0.7

# Team monthly token budget used on the Forecast page
MONTHLY_TOKEN_BUDGET=850000000
